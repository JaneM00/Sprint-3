import time
import unittest
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# Локаторы для главной страницы
MAIN_PAGE_URL = 'https://stellarburgers.nomoreparties.site/'
LOGIN_BUTTON_MAIN_PAGE = '//a[contains(@href,"/login")]'
REGISTER_BUTTON_MAIN_PAGE = '//a[contains(@href,"/register")]'
PERSONAL_ACCOUNT_LINK = '//p[contains(@class,"AppHeader_header__linkText__bZTlX AppHeader_header__link__1f_O6")]'
BURGER_LOGO = '//div[contains(@class,"AppHeader_header__logo__2TDzT")]'

# Локаторы для формы входа
LOGIN_FORM_EMAIL_INPUT = '//input[@name="email"]'
LOGIN_FORM_PASSWORD_INPUT = '//input[@name="password"]'
LOGIN_FORM_SUBMIT_BUTTON = '//button[@type="submit"]'

# Локаторы для формы регистрации
REGISTRATION_FORM_NAME_INPUT = '//input[@name="name"]'
REGISTRATION_FORM_EMAIL_INPUT = '//input[@name="email"]'
REGISTRATION_FORM_PASSWORD_INPUT = '//input[@name="password"]'
REGISTRATION_FORM_SUBMIT_BUTTON = '//button[@type="submit"]'

# Локаторы для конструктора бургера
CONSTRUCTOR_BUNS_SECTION = '//section[@id="buns"]'
CONSTRUCTOR_SAUCE_SECTION = '//section[@id="sauces"]'
CONSTRUCTOR_FILLINGS_SECTION = '//section[@id="fillings"]'

# Локаторы для личного кабинета
PERSONAL_ACCOUNT_LOGOUT_BUTTON = '//button[contains(@class,"profile-form__exit")]'
FORGOT_PASSWORD_LINK = '//a[contains(text(),"Забыли?")]'

class PersonalAccountTests(unittest.TestCase):

    def setUp(self):
        pass  # Всё управление браузером передано в фикстуру

    def tearDown(self):
        pass  # Всё управление браузером передано в фикстуру

    # Тест перехода в личный кабинет по клику на «Личный кабинет»
    def test_personal_account_link_click(self, browser):
        browser.get(MAIN_PAGE_URL)
        browser.find_element(By.XPATH, PERSONAL_ACCOUNT_LINK).click()
        self.wait.until(EC.url_contains('/account'))

    # Тест выхода из аккаунта
    def test_logout(self, browser):
        browser.get(MAIN_PAGE_URL)
        browser.find_element(By.XPATH, LOGIN_BUTTON_MAIN_PAGE).click()
        self.wait.until(EC.visibility_of_element_located((By.XPATH, LOGIN_FORM_EMAIL_INPUT)))
        
        # Вход в аккаунт
        browser.find_element(By.XPATH, LOGIN_FORM_EMAIL_INPUT).send_keys('existing_user@example.com')
        browser.find_element(By.XPATH, LOGIN_FORM_PASSWORD_INPUT).send_keys('valid_password')
        browser.find_element(By.XPATH, LOGIN_FORM_SUBMIT_BUTTON).click()

        # Переходим в личный кабинет
        self.wait.until(EC.visibility_of_element_located((By.XPATH, PERSONAL_ACCOUNT_LINK)))
        browser.find_element(By.XPATH, PERSONAL_ACCOUNT_LINK).click()

        # Нажимаем кнопку выхода
        browser.find_element(By.XPATH, PERSONAL_ACCOUNT_LOGOUT_BUTTON).click()

        # Проверяем успешность выхода
        self.wait.until(EC.visibility_of_element_located((By.XPATH, LOGIN_BUTTON_MAIN_PAGE)))
        login_button_text = browser.find_element(By.XPATH, LOGIN_BUTTON_MAIN_PAGE).text
        self.assertEqual(login_button_text, 'Войти')
