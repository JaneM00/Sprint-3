import time
import unittest
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from locators import *

class PersonalAccountTests(unittest.TestCase):

    def setUp(self):
        self.browser = webdriver.Chrome()
        self.wait = WebDriverWait(self.browser, 10)

    def tearDown(self):
        self.browser.quit()

    # Тест перехода в личный кабинет по клику на «Личный кабинет»
    def test_personal_account_link_click(self):
        self.browser.get(MAIN_PAGE_URL)
        self.browser.find_element(By.XPATH, PERSONAL_ACCOUNT_LINK).click()
        self.wait.until(EC.url_contains('/account'))

    # Тест выхода из аккаунта
    def test_logout(self):
        self.browser.get(MAIN_PAGE_URL)
        self.browser.find_element(By.XPATH, LOGIN_BUTTON_MAIN_PAGE).click()
        wait.until(EC.visibility_of_element_located((By.XPATH, LOGIN_FORM_EMAIL_INPUT)))
        
        # Вход в аккаунт
        self.browser.find_element(By.XPATH, LOGIN_FORM_EMAIL_INPUT).send_keys('existing_user@example.com')
        self.browser.find_element(By.XPATH, LOGIN_FORM_PASSWORD_INPUT).send_keys('valid_password')
        self.browser.find_element(By.XPATH, LOGIN_FORM_SUBMIT_BUTTON).click()

        # Переходим в личный кабинет
        self.wait.until(EC.visibility_of_element_located((By.XPATH, PERSONAL_ACCOUNT_LINK)))
        self.browser.find_element(By.XPATH, PERSONAL_ACCOUNT_LINK).click()

        # Нажимаем кнопку выхода
        self.browser.find_element(By.XPATH, PERSONAL_ACCOUNT_LOGOUT_BUTTON).click()

        # Проверяем успешность выхода
        self.wait.until(EC.visibility_of_element_located((By.XPATH, LOGIN_BUTTON_MAIN_PAGE)))
        login_button_text = self.browser.find_element(By.XPATH, LOGIN_BUTTON_MAIN_PAGE).text
        self.assertEqual(login_button_text, 'Войти')
