import time
import unittest
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# Локаторы для главной страницы
MAIN_PAGE_URL = 'https://stellarburgers.nomoreparties.site/'
LOGIN_BUTTON_MAIN_PAGE = '//a[contains(@href,"/login")]'
REGISTER_BUTTON_MAIN_PAGE = '//a[contains(@href,"/register")]'
PERSONAL_ACCOUNT_LINK = '//p[contains(@class,"AppHeader_header__linkText__bZTlX AppHeader_header__link__1f_O6")]'
BURGER_LOGO = '//div[contains(@class,"AppHeader_header__logo__2TDzT")]'

# Локаторы для формы входа
LOGIN_FORM_EMAIL_INPUT = '//input[@name="email"]'
LOGIN_FORM_PASSWORD_INPUT = '//input[@name="password"]'
LOGIN_FORM_SUBMIT_BUTTON = '//button[@type="submit"]'

# Локаторы для формы регистрации
REGISTRATION_FORM_NAME_INPUT = '//input[@name="name"]'
REGISTRATION_FORM_EMAIL_INPUT = '//input[@name="email"]'
REGISTRATION_FORM_PASSWORD_INPUT = '//input[@name="password"]'
REGISTRATION_FORM_SUBMIT_BUTTON = '//button[@type="submit"]'

# Локаторы для конструктора бургера
CONSTRUCTOR_BUNS_SECTION = '//section[@id="buns"]'
CONSTRUCTOR_SAUCE_SECTION = '//section[@id="sauces"]'
CONSTRUCTOR_FILLINGS_SECTION = '//section[@id="fillings"]'

# Локаторы для личного кабинета
PERSONAL_ACCOUNT_LOGOUT_BUTTON = '//button[contains(@class,"profile-form__exit")]'
FORGOT_PASSWORD_LINK = '//a[contains(text(),"Забыли?")]'

class RegistrationTests(unittest.TestCase):

    def setUp(self):
        pass  # Всё управление браузером передано в фикстуру

    def tearDown(self):
        pass  # Всё управление браузером передано в фикстуру

    # Тест успешной регистрации
    def test_successful_registration(self, browser):
        browser.get(MAIN_PAGE_URL)
        browser.find_element(By.XPATH, REGISTER_BUTTON_MAIN_PAGE).click()
        self.wait.until(EC.visibility_of_element_located((By.XPATH, REGISTRATION_FORM_NAME_INPUT)))
        
        # Генерируем уникальный email
        unique_email = f'test_{time.time()}@example.com'

        # Заполняем форму регистрации
        browser.find_element(By.XPATH, REGISTRATION_FORM_NAME_INPUT).send_keys('John Doe')
        browser.find_element(By.XPATH, REGISTRATION_FORM_EMAIL_INPUT).send_keys(unique_email)
        browser.find_element(By.XPATH, REGISTRATION_FORM_PASSWORD_INPUT).send_keys('123456')
        browser.find_element(By.XPATH, REGISTRATION_FORM_SUBMIT_BUTTON).click()

        # Проверяем успешность регистрации
        self.wait.until(EC.visibility_of_element_located((By.XPATH, PERSONAL_ACCOUNT_LINK)))
        personal_account_text = browser.find_element(By.XPATH, PERSONAL_ACCOUNT_LINK).text
        self.assertEqual(personal_account_text, 'Личный кабинет')

    # Тест ошибки при вводе короткого пароля
    def test_short_password_error(self, browser):
        browser.get(MAIN_PAGE_URL)
        browser.find_element(By.XPATH, REGISTER_BUTTON_MAIN_PAGE).click()
        self.wait.until(EC.visibility_of_element_located((By.XPATH, REGISTRATION_FORM_NAME_INPUT)))
        
        # Генерируем уникальный email
        unique_email = f'test_{time.time()}@example.com'

        # Заполняем форму регистрации с коротким паролем
        browser.find_element(By.XPATH, REGISTRATION_FORM_NAME_INPUT).send_keys('John Doe')
        browser.find_element(By.XPATH, REGISTRATION_FORM_EMAIL_INPUT).send_keys(unique_email)
        browser.find_element(By.XPATH, REGISTRATION_FORM_PASSWORD_INPUT).send_keys('12345')  # Пароль короче минимального
        browser.find_element(By.XPATH, REGISTRATION_FORM_SUBMIT_BUTTON).click()

        # Проверяем наличие ошибки
        error_message = browser.find_element(By.CLASS_NAME, 'error').text
        self.assertIn('Пароль должен содержать минимум 6 символов', error_message)
